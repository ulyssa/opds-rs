        "@type": "http://schema.org/Book",
        "title": "Helena - Tome 1",
        "subtitle": "Les rêves piégés",
        "author": [
          {
            "name": "Katherine Girard",
            "links": [
              {
                "href": "https://catalog.feedbooks.com/browse/recent.json?author_ids=546927&languages=fr",
